{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "node patch-xlsx.cjs",
    "dev": "tsx server.ts",
    "build": "npx prisma generate && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild scripts/reset-admin.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/reset-admin.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.cjs",
    "lint": "tsc --noEmit",
    "reset-admin": "node dist/reset-admin.cjs",
    "test": "NODE_ENV=test JWT_SECRET=test-secret tsx --test server.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@google/genai": "^2.16.0",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^8.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "adm-zip": "^0.5.18",
    "archiver": "^8.0.0",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "csv-parser": "^3.2.1",
    "dompurify": "^3.4.13",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.2",
    "imapflow": "^1.6.6",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "mailparser": "^3.9.15",
    "motion": "^12.43.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sqlite3": "^6.0.1",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.4.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.25",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.1",
    "@types/socket.io-client": "^1.4.36",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.25.12",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.11",
    "typescript": "~5.8.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
